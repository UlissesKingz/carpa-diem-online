# Porta local. No Render, a variável PORT é fornecida automaticamente.
PORT=3000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USUARIO:SENHA@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=carpas_online

# Protege /dev-salas e /api/admin/*
ADMIN_PASSWORD=troque-por-uma-senha-forte

# Salas inativas expiram automaticamente no Atlas após este período.
ROOM_TTL_HOURS=72
